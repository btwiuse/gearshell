#!/bin/sh
export TERM=ghostty
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
if [ "$(id -u)" -eq 0 ]; then
  export HOME=/root
fi
for applet in $(/bin/busybox --list); do
  /bin/busybox ln -sf /bin/busybox "/bin/$applet"
done
/bin/busybox mount -t tmpfs tmpfs /tmp 2>/dev/null
/bin/busybox ifconfig lo up 2>/dev/null
/bin/busybox ifconfig eth0 up 2>/dev/null
/bin/busybox udhcpc -i eth0 -s /bin/post-dhcp 2>/dev/null

# Mount cgroup v2 so dockerd / podman / runc can manage resources
# inside the guest. Minimal kernels (CGROUPS=no) have no sysfs marker
# under /sys/fs/cgroup and no cgroup2 controller, so probe /proc/filesystems
# before attempting the mount; on minimal this whole block is a no-op.
# See memory/gearshell-vm-cgroup.md for why container kernels need both overlays.
if /bin/busybox grep -qw cgroup2 /proc/filesystems && [ -d /sys/fs/cgroup ]; then
  /bin/busybox mount -t tmpfs tmpfs /sys/fs/cgroup 2>/dev/null
  /bin/busybox mount -t cgroup2 cgroup2 /sys/fs/cgroup 2>/dev/null
fi
