digraph gearshell_deps_modules {
  graph [rankdir=TB, overlap=false, splines=spline,         concentrate=true, nodesep=0.3, ranksep=0.55,         label="GearShell · module-grouped JS graph (28 groups, 198 inter-group imports)", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fontname=Helvetica,        fontsize=11, fillcolor="#eef3ff", color="#5b6dab"];
  edge [color="#7a86b3", arrowsize=0.7];

  // ── top-level module groups ─────────────────────────
  subgraph cluster_root {
    label="(root)"; style="rounded,dashed,filled";
    fillcolor="#fafbfd"; color="#c5cee5"; fontsize=10;
    "(root)" [label="(root)"];
    "app-* (shell modules)" [label="app-* (shell modules)"];
    "panels-* (panel grid)" [label="panels-* (panel grid)"];
    "plugins-* (registry)" [label="plugins-* (registry)"];
    "workspace-* (workspace APIs)" [label="workspace-* (workspace APIs)"];
  }

  // ── plugin families ───────────────────────────────
  subgraph cluster_p1 {
    label="plugin:bubbletea-playground";
